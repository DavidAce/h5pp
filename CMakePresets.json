{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "description": "Build directory shared by the generator presets.",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "pkg-cmake",
      "hidden": true,
      "description": "Build dependencies with ExternalProject through the bundled CMake provider. Install them in a local directory.",
      "cacheVariables": {
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/cmake_dependency_provider/cmake_provider.cmake",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": true
      }
    },
    {
      "name": "pkg-conan",
      "hidden": true,
      "description": "Install dependencies with Conan from PATH. Select C++20 for its generated host profile.",
      "cacheVariables": {
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/conan_dependency_provider/conan_provider.cmake",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": true,
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "github-actions",
      "hidden": true,
      "description": "Project integrations, diagnostics, and development settings used by GitHub Actions only.",
      "inherits": "default",
      "cacheVariables": {
        "H5PP_ENABLE_EIGEN3": true,
        "H5PP_ENABLE_FMT": true,
        "H5PP_ENABLE_SPDLOG": true,
        "H5PP_ENABLE_TESTS": true,
        "H5PP_BUILD_EXAMPLES": true,
        "H5PP_BUILD_DOCS": false,
        "H5PP_ENABLE_MPI": false,
        "H5PP_ENABLE_ASAN": false,
        "H5PP_ENABLE_PCH": false,
        "H5PP_ENABLE_CCACHE": true,
        "H5PP_ENABLE_COVERAGE": false,
        "H5PP_USE_QUADMATH": false,
        "H5PP_USE_FLOAT128": false,
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_EXTENSIONS": false,
        "CMAKE_POSITION_INDEPENDENT_CODE": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": false,
        "CMAKE_VERBOSE_MAKEFILE": true,
        "CMAKE_MESSAGE_LOG_LEVEL": "VERBOSE",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}"
      },
      "environment": {
        "NINJA_STATUS": "[run %r|beg %s|fin %f|tot %t|rate %o|time %e]:"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config",
      "description": "Use Ninja Multi-Config without selecting a dependency provider. Choose the compiler and optional h5pp features yourself.",
      "inherits": "default",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "ninja-pkg-cmake",
      "displayName": "Ninja with packages built by CMake",
      "inherits": [
        "pkg-cmake",
        "ninja"
      ]
    },
    {
      "name": "ninja-pkg-conan",
      "displayName": "Ninja with packages provided by Conan",
      "inherits": [
        "pkg-conan",
        "ninja"
      ]
    },
    {
      "name": "windows-vs",
      "displayName": "Visual Studio",
      "description": "Use CMake's default Windows generator with x64 architecture, without selecting a dependency provider. Leave CMAKE_GENERATOR unset to allow normal Visual Studio discovery.",
      "inherits": "default",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs-pkg-cmake",
      "displayName": "Visual Studio with packages built by CMake",
      "inherits": [
        "pkg-cmake",
        "windows-vs"
      ]
    },
    {
      "name": "windows-vs-pkg-conan",
      "displayName": "Visual Studio with packages provided by Conan",
      "inherits": [
        "pkg-conan",
        "windows-vs"
      ]
    },
    {
      "name": "github-actions-find",
      "displayName": "GitHub Actions without package management",
      "inherits": [
        "github-actions",
        "ninja"
      ],
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "github-actions-pkg-cmake",
      "displayName": "GitHub Actions with packages built by CMake",
      "inherits": [
        "github-actions",
        "ninja-pkg-cmake"
      ],
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "github-actions-pkg-conan",
      "displayName": "GitHub Actions with Conan",
      "inherits": [
        "github-actions",
        "ninja-pkg-conan"
      ],
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "github-actions-windows-pkg-cmake",
      "displayName": "GitHub Actions on Windows with packages built by CMake",
      "inherits": [
        "github-actions",
        "windows-vs-pkg-cmake"
      ]
    },
    {
      "name": "github-actions-windows-pkg-conan",
      "displayName": "GitHub Actions on Windows with Conan",
      "inherits": [
        "github-actions",
        "windows-vs-pkg-conan"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "ninja",
      "configurePreset": "ninja",
      "configuration": "Release"
    },
    {
      "name": "ninja-pkg-cmake",
      "configurePreset": "ninja-pkg-cmake",
      "configuration": "Release"
    },
    {
      "name": "ninja-pkg-conan",
      "configurePreset": "ninja-pkg-conan",
      "configuration": "Release"
    },
    {
      "name": "windows-vs",
      "configurePreset": "windows-vs",
      "configuration": "Release"
    },
    {
      "name": "windows-vs-pkg-cmake",
      "configurePreset": "windows-vs-pkg-cmake",
      "configuration": "Release"
    },
    {
      "name": "windows-vs-pkg-conan",
      "configurePreset": "windows-vs-pkg-conan",
      "configuration": "Release"
    },
    {
      "name": "github-actions-find",
      "configurePreset": "github-actions-find",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-pkg-cmake",
      "configurePreset": "github-actions-pkg-cmake",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-pkg-conan",
      "configurePreset": "github-actions-pkg-conan",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-windows-pkg-cmake",
      "configurePreset": "github-actions-windows-pkg-cmake",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-windows-pkg-conan",
      "configurePreset": "github-actions-windows-pkg-conan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "github-actions",
      "hidden": true,
      "output": {
        "verbosity": "verbose",
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "ninja",
      "configurePreset": "ninja",
      "configuration": "Release"
    },
    {
      "name": "ninja-pkg-cmake",
      "configurePreset": "ninja-pkg-cmake",
      "configuration": "Release"
    },
    {
      "name": "ninja-pkg-conan",
      "configurePreset": "ninja-pkg-conan",
      "configuration": "Release"
    },
    {
      "name": "windows-vs",
      "configurePreset": "windows-vs",
      "configuration": "Release"
    },
    {
      "name": "windows-vs-pkg-cmake",
      "configurePreset": "windows-vs-pkg-cmake",
      "configuration": "Release"
    },
    {
      "name": "windows-vs-pkg-conan",
      "configurePreset": "windows-vs-pkg-conan",
      "configuration": "Release"
    },
    {
      "name": "github-actions-find",
      "inherits": "github-actions",
      "configurePreset": "github-actions-find",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-pkg-cmake",
      "inherits": "github-actions",
      "configurePreset": "github-actions-pkg-cmake",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-pkg-conan",
      "inherits": "github-actions",
      "configurePreset": "github-actions-pkg-conan",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-windows-pkg-cmake",
      "inherits": "github-actions",
      "configurePreset": "github-actions-windows-pkg-cmake",
      "configuration": "Debug"
    },
    {
      "name": "github-actions-windows-pkg-conan",
      "inherits": "github-actions",
      "configurePreset": "github-actions-windows-pkg-conan",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "ninja",
      "description": "Configure and build. Enable optional integrations and development targets as needed.",
      "steps": [
        {
          "type": "configure",
          "name": "ninja"
        },
        {
          "type": "build",
          "name": "ninja"
        }
      ]
    },
    {
      "name": "ninja-pkg-cmake",
      "description": "Configure and build. Enable optional integrations and development targets as needed.",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-pkg-cmake"
        },
        {
          "type": "build",
          "name": "ninja-pkg-cmake"
        }
      ]
    },
    {
      "name": "ninja-pkg-conan",
      "description": "Configure and build. Enable optional integrations and development targets as needed.",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-pkg-conan"
        },
        {
          "type": "build",
          "name": "ninja-pkg-conan"
        }
      ]
    },
    {
      "name": "windows-vs",
      "description": "Configure and build. Enable optional integrations and development targets as needed.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-vs"
        },
        {
          "type": "build",
          "name": "windows-vs"
        }
      ]
    },
    {
      "name": "windows-vs-pkg-cmake",
      "description": "Configure and build. Enable optional integrations and development targets as needed.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-vs-pkg-cmake"
        },
        {
          "type": "build",
          "name": "windows-vs-pkg-cmake"
        }
      ]
    },
    {
      "name": "windows-vs-pkg-conan",
      "description": "Configure and build. Enable optional integrations and development targets as needed.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-vs-pkg-conan"
        },
        {
          "type": "build",
          "name": "windows-vs-pkg-conan"
        }
      ]
    }
  ]
}
