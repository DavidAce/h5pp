# Select a local source archive when supplied; otherwise use the recipe's download.
function(h5pp_source_archive dependency url hash)
    set(archive_var "H5PP_${dependency}_SOURCE_ARCHIVE")
    set(md5_var "${archive_var}_MD5_SUM")
    set(${archive_var} "" CACHE FILEPATH "Local ${dependency} source archive")
    set(${md5_var} "" CACHE STRING "Optional MD5 checksum for the local ${dependency} source archive")
    if(${archive_var})
        set(url "${${archive_var}}")
        if(NOT EXISTS "${url}" OR IS_DIRECTORY "${url}")
            message(FATAL_ERROR "${archive_var} is not a source archive file: ${url}")
        endif()
        set(hash "")
        if(${md5_var})
            set(hash "MD5=${${md5_var}}")
        endif()
    endif()
    set(source_args URL "${url}")
    if(hash)
        list(APPEND source_args URL_HASH "${hash}")
    endif()
    set(H5PP_SOURCE_ARGS "${source_args}" PARENT_SCOPE)
endfunction()
