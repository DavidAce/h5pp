cmake_policy(VERSION 3.26)

function(pad_string OUT_VARIABLE DESIRED_LENGTH FILL_CHAR VALUE)
    string(LENGTH "${VALUE}" VALUE_LENGTH)
    math(EXPR REQUIRED_PADS "${DESIRED_LENGTH} - ${VALUE_LENGTH}")
    set(PAD "${VALUE}")
    if(REQUIRED_PADS GREATER 0)
        string(REPEAT "${FILL_CHAR}" "${REQUIRED_PADS}" padding)
        string(APPEND PAD "${padding}")
    endif()
    set(${OUT_VARIABLE} "${PAD}" PARENT_SCOPE)
endfunction()

function(get_imported_location location target_name)
    set(${location} "" PARENT_SCOPE)
    get_target_property(PROP_IMP "${target_name}" IMPORTED)
    get_target_property(PROP_TYP "${target_name}" TYPE)
    if(NOT PROP_IMP OR PROP_TYP STREQUAL "INTERFACE_LIBRARY")
        return()
    endif()

    get_property(imported_configs TARGET "${target_name}" PROPERTY IMPORTED_CONFIGURATIONS)
    set(build_configs ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
    set(PROP_CFGS ${imported_configs} ${build_configs})
    list(TRANSFORM PROP_CFGS TOUPPER)
    list(REMOVE_DUPLICATES PROP_CFGS)

    set(PROP_VARS IMPORTED_LOCATION IMPORTED_IMPLIB)
    set(properties ${PROP_VARS})
    foreach(PROP_CFG IN LISTS PROP_CFGS)
        foreach(PROP_VAR IN LISTS PROP_VARS)
            list(APPEND properties "${PROP_VAR}_${PROP_CFG}")
        endforeach()
    endforeach()
    list(TRANSFORM build_configs TOUPPER)
    list(TRANSFORM build_configs PREPEND "MAP_IMPORTED_CONFIG_")
    list(APPEND properties ${build_configs})
    list(REMOVE_DUPLICATES properties)

    set(PROP_LOC "")
    foreach(PROP IN LISTS properties)
        get_property(PROP_SET TARGET "${target_name}" PROPERTY "${PROP}" SET)
        if(PROP_SET)
            get_property(value TARGET "${target_name}" PROPERTY "${PROP}")
            if(NOT "${PROP_LOC}" STREQUAL "")
                string(APPEND PROP_LOC " | ")
            endif()
            string(APPEND PROP_LOC "${PROP}=${value}")
        endif()
    endforeach()
    set(${location} "${PROP_LOC}" PARENT_SCOPE)
endfunction()

# Extract target names for traversal without changing the displayed properties.
function(get_link_targets link_data target_names)
    set(found_targets "")
    set(link_item "")
    set(depth 0)
    foreach(elem IN LISTS link_data)
        # A generator expression can contain a semicolon-separated list.
        if(depth GREATER 0)
            string(APPEND link_item ";${elem}")
        else()
            if(NOT elem MATCHES "^\\$<")
                if(TARGET "${elem}")
                    list(APPEND found_targets "${elem}")
                endif()
                continue()
            endif()
            set(link_item "${elem}")
        endif()
        string(REGEX MATCHALL "\\$<" openings "${elem}")
        string(REGEX MATCHALL ">" closings "${elem}")
        list(LENGTH openings num_openings)
        list(LENGTH closings num_closings)
        math(EXPR depth "${depth} + ${num_openings} - ${num_closings}")
        if(depth GREATER 0)
            continue()
        endif()
        set(depth 0)

        if(link_item MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE|BUILD_LOCAL_INTERFACE|TARGET_NAME_IF_EXISTS|TARGET_NAME|1|\\$<CONFIG:[^<>]+>):(.*)>$")
            # Include potential dependencies from every configuration.
            get_link_targets("${CMAKE_MATCH_2}" wrapped_targets)
            list(APPEND found_targets ${wrapped_targets})
        endif()
    endforeach()
    set(${target_names} "${found_targets}" PARENT_SCOPE)
endfunction()

function(expand_target_all_targets target_names expanded_list)
    foreach(target_name IN LISTS target_names)
        if(NOT TARGET "${target_name}")
            continue()
        endif()

        get_target_property(aliased_target "${target_name}" ALIASED_TARGET)
        if(NOT "${aliased_target}" STREQUAL "aliased_target-NOTFOUND")
            set(target_name "${aliased_target}")
        endif()
        if("${target_name}" IN_LIST ${expanded_list})
            continue()
        endif()
        list(APPEND ${expanded_list} "${target_name}")

        get_target_property(lib_type "${target_name}" TYPE)
        set(private_libs "")
        if(NOT lib_type STREQUAL "INTERFACE_LIBRARY")
            get_property(private_libs TARGET "${target_name}" PROPERTY LINK_LIBRARIES)
        endif()
        get_property(interface_libs TARGET "${target_name}" PROPERTY INTERFACE_LINK_LIBRARIES)
        get_link_targets("${private_libs};${interface_libs}" linked_targets)
        if(NOT "${linked_targets}" STREQUAL "")
            expand_target_all_targets("${linked_targets}" "${expanded_list}")
        endif()
    endforeach()
    return(PROPAGATE ${expanded_list})
endfunction()

# Keep each generator expression together when its payload contains a list.
function(split_target_property value entries)
    set(items "")
    set(item "")
    set(depth 0)
    foreach(fragment IN LISTS value)
        string(REPLACE ";" "\\;" fragment "${fragment}")
        if(depth GREATER 0)
            string(APPEND item ";${fragment}")
        else()
            set(item "${fragment}")
        endif()
        string(REGEX MATCHALL "\\$<" openings "${fragment}")
        string(REGEX MATCHALL ">" closings "${fragment}")
        list(LENGTH openings num_openings)
        list(LENGTH closings num_closings)
        math(EXPR depth "${depth} + ${num_openings} - ${num_closings}")
        if(depth GREATER 0)
            continue()
        endif()
        set(depth 0)
        string(REPLACE ";" "\\;" item "${item}")
        list(APPEND items "${item}")
        set(item "")
    endforeach()
    if(NOT "${item}" STREQUAL "")
        string(REPLACE ";" "\\;" item "${item}")
        list(APPEND items "${item}")
    endif()
    set(${entries} "${items}" PARENT_SCOPE)
endfunction()

function(print_target_property target_name padded_target label property)
    get_property(value TARGET "${target_name}" PROPERTY "${property}")
    get_property(interface_value TARGET "${target_name}" PROPERTY "INTERFACE_${property}")

    if("${value}" STREQUAL "${interface_value}")
        if(NOT "${value}" STREQUAL "")
            message(VERBOSE "${padded_target} PUBL ${label} : ${value}")
        endif()
        return()
    endif()
    if("${value}" STREQUAL "")
        message(VERBOSE "${padded_target} INTF ${label} : ${interface_value}")
        return()
    endif()
    if("${interface_value}" STREQUAL "")
        message(VERBOSE "${padded_target} PRIV ${label} : ${value}")
        return()
    endif()

    split_target_property("${value}" direct_entries)
    split_target_property("${interface_value}" interface_entries)
    set(PUBL "")
    set(PRIV "")
    set(INTF "")
    foreach(entry IN LISTS direct_entries)
        string(REPLACE ";" "\\;" escaped_entry "${entry}")
        if("${entry}" IN_LIST interface_entries)
            list(APPEND PUBL "${escaped_entry}")
        else()
            list(APPEND PRIV "${escaped_entry}")
        endif()
    endforeach()
    foreach(entry IN LISTS interface_entries)
        if(NOT "${entry}" IN_LIST direct_entries)
            string(REPLACE ";" "\\;" escaped_entry "${entry}")
            list(APPEND INTF "${escaped_entry}")
        endif()
    endforeach()

    foreach(scope IN ITEMS PUBL PRIV INTF)
        list(JOIN ${scope} ";" grouped_entries)
        if(NOT "${grouped_entries}" STREQUAL "")
            message(VERBOSE "${padded_target} ${scope} ${label} : ${grouped_entries}")
        endif()
    endforeach()
endfunction()

function(print_target_info target_name prefix)
    if(NOT TARGET "${target_name}")
        return()
    endif()

    get_target_property(PROP_TYP "${target_name}" TYPE)
    get_imported_location(PROP_LOC "${target_name}")

    pad_string(padded_target 64 " " "${prefix}[${target_name}]")
    message(VERBOSE "${padded_target}      TYPE    : ${PROP_TYP}")
    if(PROP_LOC)
        message(VERBOSE "${padded_target}      IMPORTS : ${PROP_LOC}")
    endif()

    print_target_property("${target_name}" "${padded_target}" LINKLIB LINK_LIBRARIES)
    print_target_property("${target_name}" "${padded_target}" INCLUDE INCLUDE_DIRECTORIES)
    print_target_property("${target_name}" "${padded_target}" OPTIONS COMPILE_OPTIONS)
    print_target_property("${target_name}" "${padded_target}" DEFINES COMPILE_DEFINITIONS)
    print_target_property("${target_name}" "${padded_target}" FEATURE COMPILE_FEATURES)
endfunction()

function(print_compiler_info prefix)
    pad_string(padded_string 64 " " "${prefix}[${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}]")
    set(configs "${CMAKE_CONFIGURATION_TYPES}")
    if("${configs}" STREQUAL "")
        set(configs "${CMAKE_BUILD_TYPE}")
    endif()
    if(NOT "${configs}" STREQUAL "")
        foreach(config IN LISTS configs)
            string(TOUPPER "${config}" BUILD_TYPE)
            string(STRIP "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${BUILD_TYPE}}" flags)
            message(VERBOSE "${padded_string}      OPTIONS : [${config}] ${flags}")
        endforeach()
    else()
        message(VERBOSE "${padded_string}      OPTIONS : ${CMAKE_CXX_FLAGS}")
    endif()
endfunction()

# Print the reachable link targets in depth-first order.
function(print_target_summary prj)
    if(NOT TARGET "${prj}")
        message(WARNING "print_target_summary: ${prj} is not a valid target")
        return()
    endif()
    cmake_language(GET_MESSAGE_LOG_LEVEL log_level)
    if(NOT log_level MATCHES "^(VERBOSE|DEBUG|TRACE)$")
        return()
    endif()
    string(TOUPPER "${prj}" PRJ)
    message(VERBOSE "| ${PRJ} TARGET SUMMARY")
    message(VERBOSE "|--------------------------")
    set(TARGET_EXPANDED "")
    expand_target_all_targets("${prj}" TARGET_EXPANDED)
    foreach(t IN LISTS TARGET_EXPANDED)
        print_target_info("${t}" "| ")
    endforeach()
    message(VERBOSE "|--------------------------")
endfunction()
